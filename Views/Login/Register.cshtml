
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="bn" ng-app="myApp">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>লগইন করুন - Bootstrap</title>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" xintegrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- SweetAlert CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <!-- SweetAlert JS -->
    <script src="https://cdn.jsdelivr.net/npm/angular-utils-pagination@0.11.1/dirPagination.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <!-- Google Fonts - Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="~/Apps/app.js"></script>
    <script src="~/Apps/Service/Service.js"></script>
    <script src="~/Apps/layoutController.js"></script>
    <style>
    </style>
</head>
<body ng-controller="LayoutController">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <div class="login-card p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h2 class="display-5 fw-bold text-dark mb-2">স্বাগতম!</h2>
                        <p class="lead text-secondary">আপনার তথ্য দিন</p>
                    </div>

                    @*<form name="myForm">
                        <p>
                            Name:
                            <input name="myName" ng-model="myName" required>
                            <span ng-show="myForm.myName.$touched && myForm.myName.$invalid">The name is required.</span>
                        </p>

                        <p>
                            Address:
                            <input name="myAddress" ng-model="myAddress" required>
                        </p>

                    </form>*@

                <form name="registerForm">
                    <div class="mb-3">
                        <label for="firstName" class="form-label">First Name</label>
                        <input type="text" class="form-control" name="firstName" ng-model="obj.T11999.FirstName" placeholder="First Name" required>
                        <span class="text-danger" ng-show="registerForm.firstName.$touched && registerForm.firstName.$invalid">
                            First Name is required!!!
                        </span>
                    </div>

                    <div class="mb-3">
                        <label for="lastName" class="form-label">Last Name</label>
                        <input type="text" class="form-control" name="lastName" ng-model="obj.T11999.LastName" placeholder="Last Name" required>
                        <span class="text-danger" ng-show="registerForm.lastName.$touched && registerForm.lastName.$invalid">
                            Last Name is required!!!
                        </span>
                    </div>

                    <div class="mb-3">
                        <label for="mobileNo" class="form-label">Mobile No</label>
                        <input type="text" class="form-control" name="mobileNo" ng-pattern="/^[0-9]{11}$/" maxlength="11" ng-keypress="($event.charCode >= 48 && $event.charCode <= 57) ? true : $event.preventDefault()" ng-model="obj.T11999.MobileNo" placeholder="11 digit Mobile Number" required>
                        <span class="text-danger" ng-show="registerForm.mobileNo.$touched && registerForm.mobileNo.$invalid">
                            Mobile number is required!!!
                        </span>
                    </div>
                    <div class="mb-3">
                        <label for="emailId" class="form-label">Email</label>
                        <input type="email" class="form-control" name="emailId" ng-model="obj.T11999.Email" placeholder="Email Address" required>
                        <span class="text-danger" ng-show="registerForm.emailId.$touched && registerForm.emailId.$invalid">
                            Email Address is required!!!
                        </span>
                    </div>

                    <div class="mb-3">
                        <label for="userName" class="form-label">User Name</label>
                        <input type="text" class="form-control" name="userName" ng-model="obj.T11999.Username" placeholder="User Name" required>
                        <span class="text-danger" ng-show="registerForm.userName.$touched && registerForm.userName.$invalid">
                            User Name is required!!!
                        </span>
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <input type="password" class="form-control" name="password" ng-model="obj.T11999.PasswordHash" placeholder="আপনার পাসওয়ার্ড লিখুন (কমপক্ষে ৬ অক্ষর)" minlength="6" required>
                        <span class="text-danger" ng-show="registerForm.password.$touched && registerForm.password.$invalid">
                            Password is required!!!
                        </span>
                    </div>

                    <div class="mb-4">
                        <label for="confirm_password" class="form-label">Confirm Password</label>
                        <input type="password" class="form-control" name="confirm_password" ng-model="obj.T11999.ConfirmPassword" placeholder="আপনার পাসওয়ার্ড আবার লিখুন" required>
                        <span class="text-danger"
                              ng-show="obj.T11999.PasswordHash !== obj.T11999.ConfirmPassword">
                            পাসওয়ার্ড মেলেনি
                        </span>
                    </div>


                    <button type="submit" ng-disabled="registerForm.$invalid || obj.T11999.PasswordHash !== obj.T11999.ConfirmPassword" class="btn btn-primary btn-register" ng-click="SignUpClick()">রেজিস্টার করুন</button>
                </form>

                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS CDN (Popper.js and Bootstrap JS bundle) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" xintegrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <!-- Lucide Icons CDN for icons -->
    <script src="https://cdn.jsdelivr.net/npm/lucide-icons@0.321.0/dist/umd/lucide.min.js"></script>
    @*<script>
            // লুসিড আইকন ইনিশিয়ালাইজেশন
            window.onload = function () {
                lucide.createIcons();
            };
        </script>*@
</body>
</html>

