@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<script src="~/Apps/Setup/T11222Controller.js"></script>

<div class="container" ng-controller="T11222Controller">
    @*<div class="float-end mb-3">
        <input type="button" value="Save" class="btn btn-outline-success" ng-click="btnSaveClick()" />
        <input type="button" value="Clear" class="btn btn-outline-secondary" ng-click="btnClearClick()" />
        <input type="button" value="Delete" class="btn btn-outline-danger" ng-click="btnDeleteClick()" />
    </div>*@

    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">নতুন সাব ক্যাটাগরি যোগ করুন</h4>
                </div>
                <div class="card-body">
                    <form>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="subCategoryId" class="form-label">Sub Category Id</label>
                                <input type="text" class="form-control" ng-model="obj.T11222.SubCategoryId" id="subCategoryId" readonly>
                            </div>
                            <div class="col-md-6">
                                <label for="ddlItemCategories" class="form-label">Category</label>
                                <select id="ddlItemCategories" class="form-select" ng-model="obj.ddlItemCategories" ng-options="V.Name for V in obj.categories track by V.CategoryId" required>
                                    <option value="">Select One</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="subCategoryName" class="form-label">Name</label>
                            <input type="text" class="form-control" ng-model="obj.T11222.Name" id="subCategoryName" required>
                        </div>

                        <div class="mb-3">
                            <label for="subCategoryDescription" class="form-label">Description</label>
                            <textarea class="form-control" ng-model="obj.T11222.Description" id="subCategoryDescription" rows="3"></textarea>
                        </div>

                        <div class="row g-2 mt-3">
                            <div class="col-12 col-md-auto">
                                <button type="button" class="btn btn-outline-success w-100" ng-click="btnSaveClick()">Save</button>
                            </div>
                            <div class="col-12 col-md-auto">
                                <button type="button" class="btn btn-outline-secondary w-100" ng-click="btnClearClick()">Clear</button>
                            </div>
                            <div class="col-12 col-md-auto">
                                <button type="button" class="btn btn-outline-danger w-100" ng-click="btnDeleteClick()">Delete</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <hr />

    <!-- Search and Table -->
    <div class="mt-4">
        <input type="text" class="form-control mb-3" placeholder="🔍 Search..." ng-model="searchText">

        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Id</th>
                        <th>Category Name</th>
                        <th>Sub Category Name</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr dir-paginate="subCat in obj.subCategories | filter:searchText | itemsPerPage: pageSize"
                        ng-click="selectSubCategory(subCat)"
                        ng-class="{'table-warning': selectedSubCategory === subCat.SubCategoryId}">
                        <td>{{ subCat.SubCategoryId }}</td>
                        <td>{{ subCat.CategoryName }}</td>
                        <td>{{ subCat.Name }}</td>
                        <td>{{ subCat.Description }}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <dir-pagination-controls template-url="/Content/Template/pagination.html"
                                 max-size="5" direction-links="true" boundary-links="true">
        </dir-pagination-controls>
    </div>
</div>

