
@{
    ViewBag.Title = "T11224";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<script src="~/Apps/Setup/T11224Controller.js"></script>
<h2 class="text-success">T11224 - Products List</h2>

<!-- Search and Table -->
<div ng-controller="T11224Controller" class="mt-4">
    <input type="text" class="form-control mb-3" placeholder="🔍 Search..." ng-model="searchText">

    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Id</th>
                    <th>Product Name</th>
                    <th>Price</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="product in obj.productList | filter:searchText | itemsPerPage: pageSize"
                    ng-click="selectSubCategory(subCat)"
                    ng-class="{'table-warning': selectedSubCategory === subCat.SubCategoryId}">
                    <td>{{ product.ProductId }}</td>
                    <td>{{ product.ProductName }}</td>
                    <td>{{ product.Price }}</td>
                    <td>{{ product.ProductDescription }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    <dir-pagination-controls template-url="/Content/Template/pagination.html"
                             max-size="5" direction-links="true" boundary-links="true">
    </dir-pagination-controls>
</div>