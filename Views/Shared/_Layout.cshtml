<!DOCTYPE html>
<html ng-app="myApp">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght=300;400;500;600;700&family=Hind+Siliguri:wght=300;400;500;600;700&display=swap" rel="stylesheet">
    
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/angular-utils-pagination@0.11.1/dirPagination.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular-sanitize.min.js"></script>

    <script src="~/Apps/app.js"></script>
    <script src="~/Apps/Service/Service.js"></script>
    <script src="~/Apps/layoutController.js"></script>
    <script src="~/Apps/homepageController.js"></script>
    <script src="~/Apps/ProductDetailsController.js"></script>
    <script src="~/Apps/cartPageController.js"></script>
    @*<script src="~/Apps/checkoutController.js"></script>*@

    <style>
        * {
            font-family: 'Poppins', 'Hind Siliguri', sans-serif;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #f8f9fa;
            color: #333;
            overflow-x: hidden;
        }

        header {
            z-index: 1060 !important;
        }

        /* --- THE RESPONSIVE PUSH/DRAWER SIDEBAR --- */
        .sidebar {
            position: fixed;
            top: 0;
            left: -300px;
            width: 260px;
            height: 100%;
            background-color: #fff;
            box-shadow: 2px 0 15px rgba(0, 0, 0, 0.08);
            transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1), width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 1050;
            padding-top: 75px;
            display: flex;
            flex-direction: row;
            overflow: visible;
        }

        .sidebar.show {
            left: 0 !important;
        }

        @@media (min-width: 992px) {
            .sidebar.show.has-subcategory {
                width: calc(260px + 280px) !important;
            }
        }

        .hamburger-area {
            cursor: pointer;
            padding: 6px 10px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .hamburger-area:hover {
                background-color: #e1fda0;
                /*background-color: #e9ecef;*/
            }

        .sidebar-category-list {
            width: 260px;
            flex-shrink: 0;
            padding: 0;
            margin: 0;
            list-style: none;
            overflow-y: auto;
            height: 100%;
            border-right: 1px solid #f1f1f1;
        }

        .sidebar-category-list .list-group-item {
            border: none;
            padding: 0;
        }

        .category-item-link {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            padding: 14px 20px;
            text-decoration: none;
            color: #333;
            font-size: 15px;
            font-weight: 500;
            transition: background 0.2s, color 0.2s;
            background: none;
            border: none;
            text-align: left;
        }

        .category-item-link:hover, .active-category-style {
            /*background-color: #f8f9fa;*/
            background-color: #e1fda0;
            color: #0d6efd;
        }

        .subcategory-desktop-panel {
            position: absolute;
            left: 260px;
            top: 0;
            margin-top: 75px;
            width: 280px;
            height: calc(100% - 75px);
            background-color: #fff;
            padding: 20px;
            overflow-y: auto;
            z-index: 1045;
            border-left: 1px solid #f1f1f1;
            display: none;
        }

        @@media (min-width: 992px) {
            .subcategory-desktop-panel.show-sub {
                display: block !important;
            }
        }

        .subcategory-mobile-drawer {
            background-color: #fcfcfc;
            border-bottom: 1px solid #eaeaea;
            padding: 5px 0 10px 0;
        }

        .subcategory-mobile-link {
            display: block;
            padding: 10px 20px 10px 35px;
            font-size: 14px;
            color: #555;
            text-decoration: none;
            transition: all 0.2s;
        }

        .subcategory-mobile-link:hover {
            color: #dc3545;
            background-color: #fff1f2;
        }

        .hover-arrow {
            transition: transform 0.2s ease;
        }

        .main-content-wrapper {
            transition: padding-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            width: 100%;
            padding-top: 6.5rem;
            padding-left: 0;
        }

        @@media (min-width: 992px) {
            .main-content-wrapper {
                padding-top: 5.5rem;
            }
            body.sidebar-open .main-content-wrapper {
                padding-left: 260px;
            }
            body.sidebar-open-with-sub .main-content-wrapper {
                padding-left: calc(260px + 280px);
            }
        }

        .mobile-backdrop {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.3);
            z-index: 1040;
            display: none;
        }

        @@media (max-width: 991.98px) {
            .mobile-backdrop.active {
                display: block;
            }
        }
    </style>
</head>

<body ng-controller="LayoutController" 
      ng-class="{ 
        'sidebar-open': sidebarVisible, 
        'sidebar-open-with-sub': sidebarVisible && hoveredCategory && hoveredCategory.subcategories.length 
      }">

    <div class="mobile-backdrop" 
         ng-class="{'active': sidebarVisible}" 
         ng-click="sidebarVisible = false; hoveredCategory = null;"></div>

    <header class="bg-white py-2 shadow-sm fixed-top border-bottom">
        <div class="container-fluid">
            <div class="row align-items-center gy-2">
                
                <div class="col-6 col-md-3 d-flex align-items-center gap-2">
                    <div class="hamburger-area" ng-click="sidebarVisible = !sidebarVisible" ng-mouseenter="sidebarVisible = true">
                        <i class="bi bi-list" style="font-size: 1.8rem; color: #222;"></i>
                    </div>
                    <a href="@Url.Action("Index", "Home")" class="navbar-brand m-0">
                        <img src="~/Images/logo.jpg" alt="Logo" style="height: 38px; max-width: 100%; object-fit: contain;" />
                    </a>
                </div>

                <div class="col-12 col-md-6 order-3 order-md-2">
                    <div class="position-relative mx-lg-3">
                        <span class="position-absolute top-50 start-0 translate-middle-y ps-3 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control form-control-md ps-5"
                               placeholder="Search for products (e.g. eggs, milk...)"
                               ng-model="searchText"
                               ng-keyup="$event.keyCode == 13 && searchProduct()"
                               style="border-radius: 20px; background-color: #f1f3f4; border: 1px solid transparent;" />
                    </div>
                </div>

                <div class="col-6 col-md-3 order-2 order-md-3 d-flex align-items-center justify-content-end gap-2">
                    <a href="@Url.Action("Cart","Home")" class="btn btn-light position-relative border rounded-circle d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <i class="bi bi-cart3 fs-5 text-dark"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 10px; padding: 4px 6px;">
                            {{ cartItemCount }}
                        </span>
                    </a>
                    @*<a href="@Url.Action("Login","Login")" class="btn btn-primary px-3 rounded-pill d-flex align-items-center gap-1">
            <i class="bi bi-person-circle fs-5"></i>
            <span class="d-none d-sm-inline" style="text-transform: none; font-weight:600;">Login</span>
        </a>*@
                    @if (Session["Username"] != null)
                    {
                        var displayName = Session["FirstName"] != null && !string.IsNullOrWhiteSpace(Session["FirstName"].ToString())
                            ? Session["FirstName"].ToString()
                            : Session["Username"].ToString();

                        <!-- Logged In User Dropdown -->
                        <div class="dropdown">
                            <button class="btn btn-outline-primary rounded-pill dropdown-toggle d-flex align-items-center gap-2 px-3"
                                    type="button"
                                    id="userDropdown"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="bi bi-person-circle fs-5"></i>
                                <span style="font-weight: 600;">@displayName</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="userDropdown">
                                <li>
                                    <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="@Url.Action("Index", "UserProfile")">
                                        <i class="bi bi-person text-primary fs-5"></i> User Information
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="@Url.Action("MyOrders", "Order")">
                                        <i class="bi bi-bag-check text-success fs-5"></i> Order List
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item py-2 d-flex align-items-center gap-2 text-danger" href="javascript:void(0)" ng-click="Logout_Click()">
                                        <i class="bi bi-box-arrow-right fs-5"></i> Logout
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <!-- Guest User Login Button -->
                        <a href="@Url.Action("Login","Login")" class="btn btn-primary px-3 rounded-pill d-flex align-items-center gap-1">
                            <i class="bi bi-person-circle fs-5"></i>
                            <span class="d-none d-sm-inline" style="text-transform: none; font-weight:600;">Login</span>
                        </a>
                    }
                </div>

            </div>
        </div>
    </header>

    <div class="sidebar"
         ng-mouseleave="sidebarVisible = false; hoveredCategory = null;"
         ng-class="{ 'show': sidebarVisible, 'has-subcategory': sidebarVisible && hoveredCategory && hoveredCategory.subcategories.length }">
        
        <ul class="sidebar-category-list">
            <li class="list-group-item" 
                ng-repeat="cat in categories"
                ng-mouseover="showSubcategories(cat)">
                
                <a class="category-item-link" 
                   ng-href="{{baseUrl}}/Home/Index?catid={{cat.categoryid}}"
                   ng-class="{'active-category-style': hoveredCategory === cat}">
                    <span>{{ cat.name }}</span>
                    <i class="bi bi-chevron-right hover-arrow text-muted fs-6" 
                       ng-style="hoveredCategory === cat && {'transform': 'rotate(90deg)'}"></i>
                </a>

                <div class="subcategory-mobile-drawer d-block d-lg-none" ng-if="hoveredCategory === cat && cat.subcategories.length">
                    <a class="subcategory-mobile-link" 
                       ng-repeat="sub in cat.subcategories"
                       href="{{baseUrl}}/Home/Index?subcatid={{sub.SubCategoryId}}">
                        <i class="bi bi-arrow-right-short me-1 text-muted"></i> {{ sub.Name }}
                    </a>
                </div>
                <div class="subcategory-mobile-drawer d-block d-lg-none" ng-if="hoveredCategory === cat && !cat.subcategories.length">
                    <span class="text-muted small ps-4 py-2 d-block">কোনো সাব-ক্যাটাগরি নেই।</span>
                </div>

            </li>
        </ul>

        <div class="subcategory-desktop-panel" 
             ng-class="{'show-sub': hoveredCategory && hoveredCategory.subcategories.length}">
            <h5 class="text-primary border-bottom pb-2 mb-3 fw-bold" ng-if="hoveredCategory">{{ hoveredCategory.name }}</h5>
            <div class="row row-cols-1 g-2" ng-if="hoveredCategory">
                <div class="col" ng-repeat="sub in hoveredCategory.subcategories">
                    <a href="{{baseUrl}}/Home/Index?subcatid={{sub.SubCategoryId}}" 
                       class="text-decoration-none text-dark d-block py-1 fs-6"
                       style="transition: color 0.1s;"
                       onmouseover="this.style.color='red'"
                       onmouseout="this.style.color='#222'">
                        • {{ sub.Name }}
                    </a>
                </div>
            </div>
        </div>
    </div>
   
    <main class="main-content-wrapper">
        <div class="container-fluid px-3 px-md-4">
            @RenderBody()
        </div>
    </main>

    @Html.Partial("_LoginModal")

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</body>
</html>