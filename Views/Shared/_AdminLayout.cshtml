@{
    Layout = null;
}
<!DOCTYPE html>
<html ng-app="myApp">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>

    <!-- ✅ Bootstrap 5 + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- ✅ AngularJS + Pagination -->
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/angular-utils-pagination@0.11.1/dirPagination.js"></script>

    <!-- ✅ SweetAlert2 -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>

    <!-- ✅ Custom Angular Scripts -->
    <script src="~/Apps/app.js"></script>
    <script src="~/Apps/Service/Service.js"></script>
    <script src="~/Apps/Common/ModuleController.js"></script>

    <style>
        .headerColor {
            background-color: #d3ae78;
        }

        .sidebar-fixed {
            width: 200px;
            height: 100vh;
            position: fixed;
            top: 56px; /* Navbar height */
            left: 0;
            background-color: #696363;
            overflow-y: auto;
            z-index: 1030;
        }

        .sidebar-fixed a {
            color: white;
            text-decoration: none;
            display: block;
            padding: 10px 15px;
        }

        .sidebar-fixed a:hover {
            background-color: #888;
        }

        .content-area {
            margin-left: 200px;
            padding: 20px;
            margin-top: 50px; /* navbar height adjust */
        }

        @@media (max-width: 767.98px) {
            .sidebar-fixed {
                display: none;
            }

            .content-area {
                margin-left: 0;
                margin-top: 50px; /* responsive mode এও margin-top রাখো */
            }
        }

        .footerlogout {
            position: absolute;
            bottom: 10px;
            left: 15px;
            color: white;
            cursor: pointer;
        }

        /* Loader */
        .loader-overlay {
            position: fixed;
            top: 0;
            left: 0;
            height: 100%;
            width: 100%;
            background: rgba(255, 255, 255, 0.8);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 1050;
        }

        .lds-dual-ring {
            display: inline-block;
            width: 80px;
            height: 80px;
        }

        .lds-dual-ring:after {
            content: " ";
            display: block;
            width: 64px;
            height: 64px;
            margin: 8px;
            border-radius: 50%;
            border: 6px solid #198754;
            border-color: #198754 transparent #198754 transparent;
            animation: lds-dual-ring 1.2s linear infinite;
        }

        @@keyframes lds-dual-ring {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }
    </style>
</head>

<body ng-controller="ModuleController">
    <!-- 🔰 Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark headerColor fixed-top shadow-sm">
        <div class="container-fluid">
            <!-- Mobile Sidebar Toggle -->
            <button class="btn btn-outline-light d-md-none me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar">
                <i class="bi bi-list"></i>
            </button>

            <a class="navbar-brand fw-bold" href="@Url.Action("Index", "Home")">bazar.com</a>
        </div>
    </nav>

    <!-- 🔰 Sidebar for large screen -->
    <div class="sidebar-fixed d-none d-md-block">
        <a href="~/Home/H00001">Home</a>
        <a data-bs-toggle="collapse" href="#setupMenu">Setup</a>
        <div id="setupMenu" class="collapse">
            <div ng-repeat="S in obj.setupList">
                <a class="ms-3" ng-click="PageRedirect_Clic(S.LinkText)">{{S.FormName}}</a>
            </div>
        </div>

        <a data-bs-toggle="collapse" href="#transMenu">Transaction</a>
        <div id="transMenu" class="collapse">
            <div ng-repeat="T in obj.transList">
                <a class="ms-3" ng-click="PageRedirect_Clic(T.LinkText)">{{T.FormName}}</a>
            </div>
        </div>

        <a data-bs-toggle="collapse" href="#reportMenu">Report</a>
        <div id="reportMenu" class="collapse">
            <div ng-repeat="R in obj.reportList">
                <a class="ms-3" ng-click="PageRedirect_Clic(R.LinkText)">{{R.FormName}}</a>
            </div>
        </div>

        <span class="footerlogout" title="Logout" ng-click="Logout_Click()">Logout</span>
    </div>

    <!-- 🔰 Sidebar for small screens -->
    <div class="offcanvas offcanvas-start text-bg-dark" id="mobileSidebar">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title">Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body">
            <a href="~/Home/H00001" class="text-white">Home</a>
            <a data-bs-toggle="collapse" href="#mSetupMenu" class="text-white">Setup</a>
            <div id="mSetupMenu" class="collapse">
                <div ng-repeat="S in obj.setupList">
                    <a class="ms-3 text-white" ng-click="PageRedirect_Clic(S.LinkText)">{{S.FormName}}</a>
                </div>
            </div>
            <a data-bs-toggle="collapse" href="#mTransMenu" class="text-white">Transaction</a>
            <div id="mTransMenu" class="collapse">
                <div ng-repeat="T in obj.transList">
                    <a class="ms-3 text-white" ng-click="PageRedirect_Clic(T.LinkText)">{{T.FormName}}</a>
                </div>
            </div>
            <a data-bs-toggle="collapse" href="#mReportMenu" class="text-white">Report</a>
            <div id="mReportMenu" class="collapse">
                <div ng-repeat="R in obj.reportList">
                    <a class="ms-3 text-white" ng-click="PageRedirect_Clic(R.LinkText)">{{R.FormName}}</a>
                </div>
            </div>
            <hr />
            <a class="btn btn-danger w-100" ng-click="Logout_Click()">Logout</a>
        </div>
    </div>

    <!-- 🔰 Loader -->
    <div ng-show="isLoading" class="loader-overlay">
        <div class="lds-dual-ring"></div>
        <p class="mt-3 fw-bold text-success">Loading...</p>
    </div>

    <!-- 🔰 Main Content -->
    <main class="content-area">
        @RenderBody()
    </main>

    <!-- ✅ Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</body>
</html>
