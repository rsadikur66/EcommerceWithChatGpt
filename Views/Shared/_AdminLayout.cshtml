<!DOCTYPE html>
<html ng-app="myApp">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
    <!-- SweetAlert CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <!-- SweetAlert JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script src="~/Apps/app.js"></script>
    <script src="~/Apps/Service/Service.js"></script>
    <script src="~/Apps/layoutController.js"></script>
    <script src="~/Apps/homepageController.js"></script>

    <style>
        .headerColor {
            background-color: #337ab7;
            /* background-color: #076c93b0;*/
        }

        .sidenav {
            height: 100%;
            width: 188px;
            position: fixed;
            z-index: 1;
            /*top: 0;*/
            left: 0;
            background-color: #337ab7;
            /*   background-color: #076c93b0;*/
            overflow-x: hidden;
            transition: 0.5s;
            /* padding-top: 60px;*/
        }

            .sidenav a {
                padding: 0px 0px 0px 15px;
                text-decoration: none;
                font-size: 18px;
                color: #ffffff;
                display: block;
                transition: 0.3s;
            }

                .sidenav a:hover {
                    color: #f1f1f1;
                }

            .sidenav .closebtn {
                position: absolute;
                top: 0;
                right: 25px;
                font-size: 36px;
                margin-left: 50px;
            }

        @@media screen and (max-height: 450px) {
            .sidenav {
                padding-top: 15px;
            }

                .sidenav a {
                    font-size: 18px;
                }
        }

        .footerlogout {
            position: fixed;
            left: 0;
            bottom: 0;
            margin-left: 15px;
            color: white;
            text-align: center;
        }
    </style>
</head>

<body>

    @*<header class="bg-light py-2 shadow-sm fixed-top">
            <div class="container-fluid d-flex align-items-center justify-content-between">


                <div>
                    <a href="@Url.Action("Index", "Home")" class="navbar-brand fw-bold text-primary">
                        <img src="~/Content/logo.png" alt="Logo" style="height:40px;" />
                    </a>
                </div>
            </div>
        </header>*@
    <div ng-app="Metrorail" ng-controller="MenuController" class="ng-cloak">
        <div class="navbar headerColor navbar-fixed-top">
            <div class="container">
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>
                    @Html.ActionLink("Application name", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
                </div>
                <div class="navbar-collapse collapse">
                    <ul class="nav navbar-nav">
                        <li>@Html.ActionLink("Home", "Index", "Home")</li>
                        <li>@Html.ActionLink("About", "About", "Home")</li>
                        <li>@Html.ActionLink("Contact", "Contact", "Home")</li>
                    </ul>
                </div>
            </div>
        </div>
        <div id="mySidenav" class="sidenav">
            <div class="panel-group" id="accordion" style="margin-top: 20px;">
                <div class="panel panel-default" style="border:none;margin-bottom:10px">
                    @*class="panel-heading"*@
                    <div style="background-color: #337ab7; color: white">
                        <h4 class="panel-title">
                            <a href="~/Home/H00001">Home</a>
                        </h4>
                    </div>
                    <div style="background-color: #337ab7; color: white">
                        <h4 class="panel-title">
                            <a data-toggle="collapse" style="font-size:20px" data-parent="#accordion" href="#collapse1">Setup</a>
                        </h4>
                    </div>
                    <div id="collapse1" class="panel-collapse collapse">
                        <div ng-repeat="S in obj.setupList" class="panel-body" style="background-color: #337ab7; cursor: pointer; padding: 1px !important">
                            <a style="margin-left:15px" ng-click="PageRedirect_Clic(S.T_LINK)">{{S.T_LINK_NAME}}</a>
                        </div>
                    </div>
                </div>
                <div class="panel panel-default" style="border: none;margin-top:10px; margin-bottom: 10px">
                    <div style="background-color: #337ab7; color: white">
                        <h4 class="panel-title">
                            <a data-toggle="collapse" style="font-size:20px" data-parent="#accordion" href="#collapse2">Transaction</a>
                        </h4>
                    </div>
                    <div id="collapse2" class="panel-collapse collapse">
                        <div ng-repeat="T in obj.transList" class="panel-body" style="background-color: #337ab7; cursor: pointer; padding: 1px !important">
                            <a style="margin-left:15px" ng-click="PageRedirect_Clic(T.T_LINK)">{{T.T_LINK_NAME}}</a>
                        </div>
                    </div>
                </div>
                <div class="panel panel-default" style="border: none; margin-top: 10px; margin-bottom: 10px">
                    <div style="background-color: #337ab7; color: white">
                        <h4 class="panel-title">
                            <a data-toggle="collapse" style="font-size:20px" data-parent="#accordion" href="#collapse3">Report</a>
                        </h4>
                    </div>
                    <div id="collapse3" class="panel-collapse collapse">
                        <div ng-repeat="R in obj.reportList" class="panel-body" style="background-color: #337ab7; cursor: pointer; padding: 1px !important">
                            <a style="margin-left:15px" ng-click="PageRedirect_Clic(R.T_LINK)">{{R.T_LINK_NAME}}</a>
                        </div>
                    </div>
                </div>
                <span class="footerlogout " title="Logout" style="font-size:25px;cursor:pointer;margin-top:12px" ng-click="Logout_Click()">Logout</span>
            </div>
        </div>

    </div>
    <div class="container" style="margin-top:5rem">
        @RenderBody()
    </div>



    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

</body>
</html>

