@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div ng-controller="ProductDetailsController">
    <div class="card shadow-lg rounded-lg">
        <div class="row g-0">
            <div class="col-md-6">
                <img ng-src="{{selectedProduct.ImageUrl}}" class="img-fluid rounded-start-lg w-100 h-100 object-fit-cover" alt="{{selectedProduct.ProductName}}">
            </div>
            <div class="col-md-6">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <h1 class="card-title text-dark mb-3">{{selectedProduct.ProductName}}</h1>
                        <p class="card-text text-muted fs-5 mb-4">{{selectedProduct.ShortDescription}}</p>
                    </div>
                    <div class="mt-auto">
                        <h3 class="card-text text-primary fw-bold mb-3">&#2547;{{selectedProduct.Price | indianNumber}}</h3>
                        <button class="btn btn-primary w-100 rounded-pill fs-5" ng-click="addToCart(selectedProduct)">
                            <i class="fas fa-shopping-cart me-2"></i> {{selectedProduct.buttonText}}
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <div class="card shadow-lg rounded-lg mt-4 p-5 w-auto">
        <div class="row">
            <h3>Description</h3>
        </div>
        <div class="row">
            <div ng-bind-html="bindProductDescription(selectedProduct.ProductDescription)"></div>
        </div>
        
    </div>
</div>
