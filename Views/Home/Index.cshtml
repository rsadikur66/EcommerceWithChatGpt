</style>
<div ng-controller="HomepageController">
    <div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-indicators">
            <button type="button" ng-repeat="banner in banners"
                    data-bs-target="#carouselExampleIndicators"
                    data-bs-slide-to="{{$index}}"
                    ng-class="{active: $index == 0}"
                    aria-current="{{$index == 0 ? 'true' : 'false'}}"
                    aria-label="Slide {{$index + 1}}"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item" ng-repeat="banner in banners" ng-class="{active: $index == 0}">
                <img ng-src="{{baseUrl}}/Images/{{banner.imageUrl}}" class="d-block w-100" alt="{{banner.altText}}">
                <div class="carousel-caption d-none d-md-block">
                    <h5>{{banner.title}}</h5>
                    <p>{{banner.description}}</p>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
    <h2 class="text-center mb-4">আমাদের পণ্যসমূহ</h2>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
        <!-- Loop through products array to create cards -->
        <div class="col" ng-repeat="product in products">
            <div class="card h-100 shadow-sm rounded-lg">
                <!-- Product Image (now a clickable link) -->
                <a ng-href="/Home/Details?id={{product.ProductId}}">
                    <img ng-src="{{product.ImageUrl}}" class="card-img-top img-fluid rounded-top-lg" alt="{{product.ProductName}}" style="height: 200px; object-fit: contain;">
                </a>
                <div class="card-body d-flex flex-column">
                    <!-- Product Name (now a clickable link) -->
                    <h6 class="card-title text-primary">
                        <a ng-href="@Url.Content("~/Home/Details")?id={{product.ProductId}}" class="text-decoration-none text-dark text-sm-start fw-semibold">
                            {{product.ProductName}}
                        </a>
                        @*ng-click="viewProductDetails(product); $event.preventDefault();"*@
                    </h6>
                    <!-- Product Description -->
                    @*<p class="card-text text-muted text-decoration-none">{{product.ProductDescription}}</p>*@
                    <!-- Product Price -->
                <h3 class="card-text text-primary fw-bold mt-2 mb-3">&#2547;{{product.Price | indianNumber}}</h3>
                    <!-- Add to Cart Button -->
                    <button class="btn btn-primary btn-sm w-100 cursor-pointer rounded-pill" ng-click="addToCart(product); $event.stopPropagation();">
                        {{product.buttonText}}
                    </button>
                </div>
            </div>
        </div>
    </div>


</div>
