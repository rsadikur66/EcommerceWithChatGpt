@{
    ViewBag.Title = "Home Page";
}
<script src="~/Apps/layoutController.js"></script>
<style>
    .card-title a {
        /*font-size: 1rem;
        line-height: 1.2rem;
        display: block;
        min-height: 48px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;*/
        font-size: 0.8rem;
        line-height: 1.2rem;
        display: -webkit-box; /* মাল্টি-লাইন ট্রাঙ্কেশন এর জন্য */
        -webkit-line-clamp: 2; /* সর্বোচ্চ ২ লাইন দেখাবে */
        -webkit-box-orient: vertical; /* উল্লম্বভাবে টেক্সট সাজানোর জন্য */
        overflow: hidden; /* অতিরিক্ত টেক্সট লুকিয়ে রাখবে */
        text-overflow: ellipsis; /* ট্রাঙ্কেট হলে ... দেখাবে */
        /* min-height: 48px; - এটি আর প্রয়োজন নেই কারণ line-clamp উচ্চতা নিয়ন্ত্রণ করবে */
    }

    .card-text {
        /* font-size: 0.9rem;
        min-height: 40px;*/
        font-size: 0.9rem;
        /* min-height: 40px; - যদি বিবরণও ট্রাঙ্কেট করতে চান, তাহলে নিচের মত করে পরিবর্তন করুন */
        display: -webkit-box;
        -webkit-line-clamp: 3; /* বিবরণের জন্য সর্বোচ্চ ৩ লাইন দেখাবে, আপনার প্রয়োজন অনুযায়ী পরিবর্তন করুন */
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }
