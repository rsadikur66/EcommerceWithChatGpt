@model ClassLibrary1.Models.InvoiceViewModel
@{
    Layout = null; // প্রিন্ট বা ডিরেক্ট ভিউয়ের জন্য লেআউট নাল রাখা হয়েছে
}

<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invoice - #ORD-@Model.OrderID</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #333;
        }

        .invoice-card {
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            padding: 40px;
            max-width: 850px;
            margin: 30px auto;
        }

        .company-logo {
            font-size: 24px;
            font-weight: 700;
            color: #0d6efd;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .invoice-title {
            font-size: 28px;
            font-weight: 700;
            color: #495057;
        }

        .table-invoice th {
            background-color: #f1f4f9;
            color: #495057;
            font-weight: 600;
            border-bottom: 2px solid #dee2e6;
        }

        .summary-table td {
            padding: 6px 12px;
        }

        @@media print {
            body {
                background-color: #fff;
            }

            .invoice-card {
                box-shadow: none;
                padding: 0;
                margin: 0;
                max-width: 100%;
            }

            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="text-center my-4 no-print">
            <button class="btn btn-primary me-2" onclick="window.print()">
                <i class="bi bi-printer-fill me-1"></i> প্রিন্ট / PDF সেভ করুন
            </button>
            <button class="btn btn-outline-secondary" onclick="window.close()">
                <i class="bi bi-x-circle me-1"></i> বন্ধ করুন
            </button>
        </div>

        <div class="invoice-card">

            <!-- Header Section -->
            <div class="row pb-4 mb-4 border-bottom">
                <div class="col-6">
                    <div class="company-logo mb-1">
                        <i class="bi bi-bag-check-fill me-2"></i>bazar.com
                    </div>
                    <p class="text-muted mb-0 small">
                        হাউজ-১২, রোড-০৫, ধানমন্ডি, ঢাকা-১২০৫<br />
                        ইমেইল: support@bazar.com<br />
                        ফোন: +880 1700-000000
                    </p>
                </div>
                <div class="col-6 text-end">
                    <h2 class="invoice-title mb-1">INVOICE</h2>
                    <span class="badge bg-success-subtle text-success fs-6 fw-normal border border-success-subtle px-3 py-1 mb-2">
                        @(Model.PaymentMethod == "COD" ? "PAID (Cash On Delivery)" : Model.PaymentMethod)
                    </span>
                    <p class="mb-0 text-muted small"><strong>ইনভয়েস নং:</strong> #ORD-@Model.OrderID</p>
                    <p class="mb-0 text-muted small"><strong>তারিখ:</strong> @Model.OrderDate.ToString("dd MMMM, yyyy")</p>
                </div>
            </div>

            <!-- Customer & Shipping Details -->
            <div class="row mb-4">
                <div class="col-6">
                    <h6 class="text-uppercase text-muted fw-bold mb-2 small">গ্রাহকের তথ্য:</h6>
                    <h5 class="mb-1">@Model.CustomerFullName</h5>
                    <p class="text-muted mb-0 small"><i class="bi bi-telephone me-1"></i> @Model.RecipientPhone</p>
                    <p class="text-muted mb-0 small"><i class="bi bi-envelope me-1"></i> @Model.CustomerEmail</p>
                    <p class="text-muted mb-0 small"><i class="bi bi-person me-1"></i> @Model.CustomerUsername</p>
                </div>
                <div class="col-6 text-end">
                    <h6 class="text-uppercase text-muted fw-bold mb-2 small">ডেলিভারি ঠিকানা:</h6>
                    <p class="mb-0 text-dark small">@Model.RecipientName</p>
                    <p class="mb-0 text-dark small">@Model.ShippingAddress</p>
                </div>
            </div>

            <!-- Product Details Table -->
            <div class="table-responsive mb-4">
                <table class="table table-invoice align-middle">
                    <thead>
                        <tr>
                            <th style="width: 5%;">#</th>
                            <th style="width: 55%;">পণ্যের বিবরণ</th>
                            <th class="text-center" style="width: 10%;">পরিমাণ</th>
                            <th class="text-end" style="width: 15%;">একক মূল্য</th>
                            <th class="text-end" style="width: 15%;">মোট</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = 1; }
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@i</td>
                                <td><strong>@item.ProductName</strong></td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">৳ @item.UnitPrice.ToString("N2")</td>
                                <td class="text-end">৳ @item.TotalPrice.ToString("N2")</td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>

            <!-- Calculation Summary -->
            <div class="row">
                <div class="col-6">
                    <div class="p-3 bg-light rounded border border-light-subtle">
                        <h6 class="fw-bold mb-1 small text-muted">পেমেন্ট নোট:</h6>
                        <p class="small text-muted mb-0">
                            পণ্য বুঝে পেয়ে ডেলিভারিম্যানকে ক্যাশ টাকা প্রদান করুন। কোনো সমস্যা থাকলে ডেলিভারি পাওয়ার ২৪ ঘণ্টার মধ্যে সাপোর্ট টিমে যোগাযোগ করার অনুরোধ করা হলো।
                        </p>
                    </div>
                </div>
                <div class="col-6">
                    <table class="table table-borderless summary-table text-end mb-0">
                        <tbody>
                            <tr>
                                <td class="text-muted">সাব-টোটাল (Subtotal):</td>
                                <td class="fw-semibold">৳ @Model.TotalAmount.ToString("N2")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">শিপিং চার্জ (Shipping):</td>
                                <td class="fw-semibold">৳ @Model.ShippingCost.ToString("N2")</td>
                            </tr>
                            <tr class="border-top">
                                <td class="fs-5 fw-bold text-dark">সর্বমোট (Total):</td>
                                <td class="fs-5 fw-bold text-primary">৳ @Model.GrandTotal.ToString("N2")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Footer -->
            <div class="row mt-5 pt-4 border-top text-center text-muted small">
                <div class="col-12">
                    <p class="mb-1">আমাদের সাথে কেনাকাটা করার জন্য ধন্যবাদ!</p>
                    <p class="mb-0">This is a system-generated invoice and does not require a physical signature.</p>
                </div>
            </div>

        </div>
    </div>

</body>
</html>