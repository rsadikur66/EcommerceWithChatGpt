
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<script src="~/Apps/Common/ModuleController.js"></script>
<style>
    body {
        font-family: 'Inter', sans-serif; /* Using Inter as specified */
        background-color: #f8f9fa; /* Light gray background */
        overflow-x: hidden; /* Prevent horizontal scroll on body */
    }

    .card {
        border-radius: 0.75rem; /* Rounded corners for cards */
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); /* Subtle shadow */
    }

    .header-section {
        background-color: #ffffff;
        border-radius: 0.75rem;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .table thead th {
        background-color: #e9ecef;
        border-bottom: 2px solid #dee2e6;
        /* border-top-left-radius: 0.75rem; /* Rounded corners for table header */
        /* border-top-right-radius: 0.75rem; */
    }

    .status-badge {
        padding: 0.35em 0.65em;
        border-radius: 0.5rem;
        font-weight: 600;
    }

    .status-complete {
        background-color: #d4edda;
        color: #155724;
    }

    .status-processing {
        background-color: #fff3cd;
        color: #856404;
    }

    .status-cancelled {
        background-color: #f8d7da;
        color: #721c24;
    }
    /* Responsive adjustments for smaller screens */
    @@media (max-width: 767.98px) {
        .header-section {
            padding: 1rem;
            margin-bottom: 1rem;
        }

        .card {
            margin-bottom: 1rem;
        }

        .table-responsive {
            border-radius: 0.75rem; /* Ensure table also has rounded corners */
            overflow-x: auto; /* Allow horizontal scroll for table on small screens if needed */
        }
    }
    /* Ensure container and main content do not cause overflow */
    .container-fluid {
        padding-right: var(--bs-gutter-x, 0.75rem);
        padding-left: var(--bs-gutter-x, 0.75rem);
    }

    main {
        overflow-x: hidden; /* Ensure main content area does not cause horizontal scroll */
    }
</style>
